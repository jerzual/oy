{
	"name": "@jerzual/uoy",
	"version": "1.0.0",
	"description": "a rogue platformer",
	"keywords": [
		"pixi",
		"platformer",
		"rogue-like"
	],
	"bugs": {
		"url": "https://github.com/jerzual/oy/issues"
	},
	"license": "MIT",
	"author": "Benjamin Legrand <benjilegnard@protonmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/jerzual/oy.git"
	},
	"type": "module",
	"main": "www/server.js",
	"scripts": {
		"dev": "vite",
		"dev:server": "ts-node src/server",
		"build": "vite build",
		"build:client": "vite build --outDir dist/client",
		"build:server": "vite build --outDir dist/server --ssr src/entry-server.ts ",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"prepare": "panda codegen",
		"e2e": "playwright test"
	},
	"dependencies": {
		"express": "^4.21.1",
		"matter-js": "^0.20.0",
		"nanoid": "^5.0.8",
		"pixi.js": "^8.5.2",
		"preact": "^10.24.3",
		"preact-async-route": "^2.2.1",
		"preact-router": "^4.1.2",
		"reactive-state": "^3.7.2",
		"reflect-metadata": "^0.1.14",
		"rot-js": "^2.2.0",
		"rxjs": "^7.8.1",
		"seedrandom": "^3.0.5",
		"socket.io": "^4.8.1",
		"socket.io-client": "^4.8.1",
		"webrtc-adapter": "^9.0.1"
	},
	"devDependencies": {
		"@pandacss/dev": "^1.8.2",
		"@playwright/test": "^1.48.2",
		"@preact/preset-vite": "^2.9.1",
		"@testing-library/preact": "^3.2.4",
		"@types/express": "^5.0.0",
		"@types/matter-js": "^0.19.7",
		"@types/node": "^24.0.0",
		"@types/seedrandom": "^3.0.8",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.0.18",
		"autoprefixer": "^10.4.20",
		"axe-core": "^4.10.2",
		"canvas": "^3.2.1",
		"injection-js": "^2.4.0",
		"jsdom": "^28.1.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"postcss": "^8.4.47",
		"supertest": "^7.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,css,json,md}": [
			"prettier --write",
			"git add"
		]
	},
	"jest": {
		"globals": {
			"ts-jest": {
				"tsConfig": "tsconfig.json"
			}
		},
		"moduleFileExtensions": [
			"ts",
			"tsx",
			"js",
			"jsx"
		],
		"moduleNameMapper": {
			"\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
			"\\.(scss|css)$": "identity-obj-proxy"
		},
		"testMatch": [
			"**/*.spec.(ts|tsx)"
		],
		"transform": {
			"^.+\\.(ts|(j|t)sx)$": "ts-jest"
		}
	}
}
