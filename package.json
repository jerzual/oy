{
	"name": "@jerzual/uoy",
	"version": "1.0.0",
	"description": "a rogue platformer",
	"keywords": [
		"pixi",
		"platformer",
		"rogue-like"
	],
	"bugs": {
		"url": "https://github.com/jerzual/oy/issues"
	},
	"license": "MIT",
	"author": "Benjamin Legrand <benjilegnard@protonmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/jerzual/oy.git"
	},
	"type": "module",
	"main": "www/server.js",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx --watch src/server.ts",
		"build": "pnpm run build:client && pnpm run build:ssr && pnpm run build:server",
		"build:client": "vite build --outDir dist/client --ssrManifest",
		"build:ssr": "vite build --outDir dist/server --ssr src/main.server.tsx",
		"build:server": "vite build --outDir dist --ssr src/server.ts --emptyOutDir false",
		"start": "NODE_ENV=production node dist/server.js",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "husky & panda codegen",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@colyseus/core": "^0.17.39",
		"@colyseus/schema": "^4.0.17",
		"@colyseus/sdk": "^0.17.34",
		"@colyseus/tools": "^0.17.19",
		"@colyseus/ws-transport": "^0.17.9",
		"colyseus": "^0.17.8",
		"express": "^5.2.1",
		"matter-js": "^0.20.0",
		"nanoid": "^5.1.6",
		"pixi.js": "^8.16.0",
		"preact": "^10.28.4",
		"preact-async-route": "^2.2.1",
		"preact-render-to-string": "^6.6.6",
		"preact-router": "^4.1.2",
		"rot-js": "^2.2.1",
		"seedrandom": "^3.0.5",
		"ws": "^8.19.0"
	},
	"devDependencies": {
		"@colyseus/testing": "^0.17.11",
		"@pandacss/dev": "^1.8.2",
		"@playwright/test": "^1.58.2",
		"@preact/preset-vite": "^2.10.3",
		"@testing-library/preact": "^3.2.4",
		"@types/express": "^5.0.6",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^24.0.0",
		"@types/seedrandom": "^3.0.8",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.0.18",
		"autoprefixer": "^10.4.27",
		"axe-core": "^4.11.1",
		"canvas": "^3.2.1",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.3.2",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"postcss": "^8.5.8",
		"supertest": "^7.2.2",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,css,json,md}": [
			"oxfmt --no-error-on-unmatched-pattern",
			"git add"
		]
	},
	"packageManager": "pnpm@10.30.1"
}
