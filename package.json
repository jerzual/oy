{
	"name": "@jerzual/uoy",
	"version": "1.0.0",
	"description": "a rogue platformer",
	"keywords": [
		"platformer",
		"rogue-like",
		"threejs"
	],
	"bugs": {
		"url": "https://github.com/jerzual/oy/issues"
	},
	"license": "MIT",
	"author": "Benjamin Legrand <benjilegnard@protonmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/jerzual/oy.git"
	},
	"type": "module",
	"main": "www/server.js",
	"scripts": {
		"dev": "vite",
		"dev:server": "tsx --watch src/server.ts",
		"build": "pnpm run build:client && pnpm run build:ssr && pnpm run build:server",
		"build:client": "vite build --outDir dist/client --ssrManifest",
		"build:ssr": "vite build --outDir dist/server --ssr src/main.server.tsx",
		"build:server": "vite build --outDir dist --ssr src/server.ts --emptyOutDir false",
		"start": "NODE_ENV=production node dist/server.js",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "husky & panda codegen",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@catppuccin/palette": "^1.8.0",
		"@colyseus/core": "^0.18.18",
		"@colyseus/schema": "^5.0.36",
		"@colyseus/sdk": "^0.18.5",
		"@colyseus/tools": "^0.18.7",
		"@colyseus/ws-transport": "^0.18.4",
		"@fontsource/press-start-2p": "^5.3.0",
		"colyseus": "^0.18.9",
		"express": "^5.2.1",
		"matter-js": "^0.20.0",
		"nanoid": "^6.0.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"rot-js": "^2.2.1",
		"seedrandom": "^3.0.5",
		"three": "^0.187.0",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@colyseus/testing": "^0.18.6",
		"@pandacss/dev": "^2.1.1",
		"@pandacss/preset-base": "^2.2.0",
		"@pandacss/preset-panda": "^2.2.0",
		"@playwright/test": "^1.63.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/express": "^5.0.6",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/seedrandom": "^3.0.8",
		"@types/supertest": "^7.2.1",
		"@types/three": "~0.187.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.0.3",
		"autoprefixer": "^10.6.1",
		"axe-core": "^4.14.0",
		"canvas": "^3.2.3",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"postcss": "^8.5.29",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.{js,css,json,md}": [
			"oxfmt --no-error-on-unmatched-pattern",
			"git add"
		]
	},
	"packageManager": "pnpm@12.11.2"
}
