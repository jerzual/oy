{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "dist/",
		"module": "ESNext",
		"moduleResolution": "node",
		"sourceMap": true,
		"esModuleInterop": true,
		"target": "ESNext",
		"allowSyntheticDefaultImports": true,
		"lib": ["ES2023", "dom"],
		"jsx": "react-jsx",
		"typeRoots": ["node_modules/@types/"],
		"types": ["node", "express", "supertest"]
	},
	"files": ["src/server.ts"]
}
